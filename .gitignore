# IDE
.vscode/
.idea/

# Local result backups (kept on disk, never pushed)
_committed_backup_*.zip

# Scratch output dir used by the --outputs-dir smoke check in the README
_smoke_check/

# Datasets are not redistributed: the raw CSVs are downloaded by the user and the
# .npy fold assets are rebuilt locally by scripts/prepare_data.py (see data/README.md)
data/**/*.csv
data/**/*.npy

# Per-fold predictions and aggregated arrays carry the datasets' target values,
# so they are produced locally by scripts/run_experiments.py rather than shipped
outputs/predictions/
outputs/arrays/
